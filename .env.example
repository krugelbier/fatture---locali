# ==============================================================================
# CONFIGURAZIONE VARIABILI D'AMBIENTE
# Fatture Locali & HACCP • Krügel – Lavis & Cafè L’Incontro – Pergine
# ==============================================================================
# Copia questo file in '.env' e personalizza i valori prima di avviare il servizio.

# ------------------------------------------------------------------------------
# 1. RETE E SERVER
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
# Domini consentiti per CORS separati da virgola (es. https://gestionale.krugel.it o * per consentire tutti)
ALLOWED_ORIGINS=*

# ------------------------------------------------------------------------------
# 2. PERSISTENZA DATABASE SQLITE
# ------------------------------------------------------------------------------
# Su Docker / Hosting cloud puntare al volume persistente montato:
DB_PATH=/data/fatture_locali.db

# ------------------------------------------------------------------------------
# 3. CREDENZIALI INIZIALI PREDEFINITE
# ------------------------------------------------------------------------------
# Password iniziale per l'utente amministratore (username: admin)
ADMIN_DEFAULT_PASSWORD=CambiaQuestaPasswordForte2026!

# Password iniziale per l'account cucina Sede 1 (username: cucina.lavis)
CUCINA_DEFAULT_PASSWORD=CucinaLavis2026!

# ------------------------------------------------------------------------------
# 4. BACKUP AUTOMATICO
# ------------------------------------------------------------------------------
# Percorso dove salvare i file compressi di backup (.db.gz)
BACKUP_DIR=/backups
# Numero di giorni di storico backup da conservare prima della cancellazione automatica
BACKUP_RETENTION_DAYS=30

# ------------------------------------------------------------------------------
# 5. INTEGRAZIONE TEAMSYSTEM DIGITAL (Opzionale)
# ------------------------------------------------------------------------------
# Ambiente: 'sandbox' per test oppure 'production' per invio/ricezione reale
TEAMSYSTEM_ENVIRONMENT=sandbox
TEAMSYSTEM_CLIENT_ID=
TEAMSYSTEM_CLIENT_SECRET=
TEAMSYSTEM_COMPANY_ID=
